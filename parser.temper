// Char is an alias for Int since characters are represented as Unicode code points
let Char = Int;

let noSlots: Mapped<String, RegexNode> =
  // Ideally, this just says `new Map([])`.
  new Map(List.of<Pair<String, RegexNode>>());

let isAsciiLetter(c: Char): Boolean {
  (c >= char"a" && c <= char"z") || (c >= char"A" && c <= char"Z")
}

let isAsciiDigit(c: Char): Boolean {
  c >= char"0" && c <= char"9"
}

let isAsciiPunctuation(c: Char): Boolean {
  (c >= 0x21 && c <= 0x2F)
    || (c >= 0x3A && c <= 0x40)
    || (c >= 0x5B && c <= 0x60)
    || (c >= 0x7B && c <= 0x7E)
}

// Java only accepts group names like this, so they're the ones every backend
// accepts.
let isCaptureName(name: String): Boolean {
  if (name.isEmpty || !isAsciiLetter(name[String.begin])) {
    return false;
  }
  for (let c of name) {
    if (!isAsciiLetter(c) && !isAsciiDigit(c)) {
      return false;
    }
  }
  true
}

// The special set behind \d, \s, or \w, or their negations \D, \S, or \W.
let shorthandSet(letter: Char): SpecialSet {
  when (letter) {
    char"d", char"D" -> Digit;
    char"s", char"S" -> Space;
    else -> Word;
  }
}

// The members of \d, \s, or \w. These are ASCII, which is how std/regex
// defines \w and how the Python and Java backends define all three.
let shorthandMembers(letter: Char): String {
  when (letter) {
    char"d", char"D" -> "0123456789";
    char"s", char"S" -> "\t\n\u{B}\u{C}\r ";
    else -> "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
  }
}

let hasCode(text: String, code: Int): Boolean {
  for (let c of text) {
    if (c == code) {
      return true;
    }
  }
  false
}

// Builds a class like [^\S\n], which no backend can express as one code set.
// It matches the codes that are in every one of `required` (the members of
// each \D, \S, or \W in the class) and aren't matched by `items` or
// `itemMembers` (the members of each \d, \s, or \w in items).
let negatedClass(items: List<CodePart>, itemMembers: String, required: List<String>): CodeSet {
  let kept = new StringBuilder();
  for (let code of required[0]) {
    var keep = !hasCode(itemMembers, code);
    for (let members of required) {
      if (!hasCode(members, code)) {
        keep = false;
      }
    }
    for (let item of items) {
      when (item) {
        is CodePoints -> if (hasCode(item.value, code)) {
          keep = false;
        }
        is CodeRange -> if (item.min <= code && code <= item.max) {
          keep = false;
        }
      }
    }
    if (keep) {
      kept.appendCodePoint(code) orelse panic();
    }
  }
  let codes = kept.toString();
  if (codes.isEmpty) {
    new CodeSet(List.of<CodePart>())
  } else {
    new CodeSet([new CodePoints(codes)])
  }
}

let isPatternSpace(c: Char): Boolean {
  hasCode(" \t\n\u{B}\u{C}\r", c)
}

// The other ASCII case of a letter.
let otherCase(letter: Char): Char {
  if (letter >= char"a" && letter <= char"z") {
    letter - char"a" + char"A"
  } else {
    letter - char"A" + char"a"
  }
}

// Rewrites a node to match ASCII letters in either case, for (?i:...).
let ignoreCase(node: RegexNode): RegexNode {
  when (node) {
    is CodePoints -> ignoreCaseText(node.value);
    is CodeRange -> new CodeSet(ignoreCaseParts([node]));
    is CodeSet -> new CodeSet(ignoreCaseParts(node.items), node.negated);
    is Or -> new Or(node.items.map { (item): RegexNode => ignoreCase(item) });
    is Sequence -> new Sequence(node.items.map { (item): RegexNode => ignoreCase(item) });
    is Repeat -> new Repeat(ignoreCase(node.item), node.min, node.max, node.reluctant);
    is Capture -> new Capture(node.name, ignoreCase(node.item));
    else -> node;
  }
}

// Turns each letter in text into a class of both cases, as in "a1" to [aA]1.
let ignoreCaseText(text: String): RegexNode {
  let pieces = new ListBuilder<RegexNode>();
  let literal = new StringBuilder();
  for (let c of text) {
    if (isAsciiLetter(c)) {
      if (!literal.toString().isEmpty) {
        pieces.add(new CodePoints(literal.toString()));
        literal.clear();
      }
      let both = new StringBuilder();
      both.appendCodePoint(c) orelse panic();
      both.appendCodePoint(otherCase(c)) orelse panic();
      pieces.add(new CodeSet([new CodePoints(both.toString())]));
    } else {
      literal.appendCodePoint(c) orelse panic();
    }
  }
  if (!literal.toString().isEmpty) {
    pieces.add(new CodePoints(literal.toString()));
  }
  when (pieces.length) {
    0 -> new CodePoints(text);
    1 -> pieces[0];
    else -> new Sequence(pieces.toList());
  }
}

// Adds the other case of every letter that the class parts cover.
let ignoreCaseParts(items: List<CodePart>): List<CodePart> {
  let parts = items.toListBuilder();
  for (let item of items) {
    when (item) {
      is CodePoints -> do {
        for (let c of item.value) {
          if (isAsciiLetter(c)) {
            parts.add(new CodePoints(String.fromCodePoint(otherCase(c)) orelse panic()));
          }
        }
      }
      is CodeRange -> do {
        let lowMin = item.min.max(char"a");
        let lowMax = item.max.min(char"z");
        if (lowMin <= lowMax) {
          parts.add(new CodeRange(otherCase(lowMin), otherCase(lowMax)));
        }
        let upMin = item.min.max(char"A");
        let upMax = item.max.min(char"Z");
        if (upMin <= upMax) {
          parts.add(new CodeRange(otherCase(upMin), otherCase(upMax)));
        }
      }
    }
  }
  parts.toList()
}

class Parser(
  public chars: String,
  public slots: Mapped<String, RegexNode> = noSlots,
) {
  public var pos: StringIndex = String.begin;
  public var errorMessage: String? = null;
  private names: MapBuilder<String, Boolean> = new MapBuilder<String, Boolean>();
  // Inside (?x:...), whitespace and # comments are ignored.
  private var extended: Boolean = false;
  // Inside (?i:...), a class like [^\Wa] has to exclude both cases of its
  // members while it's built, since afterward it's an ordinary positive set.
  private var caseless: Boolean = false;

  // Records the message and bubbles. Where a value is expected, follow it with
  // bubble() anyway, since the type checker can't tell this never returns.
  public error(e: String): Void throws Bubble {
    let position = chars.countBetween(String.begin, pos);
    errorMessage = "at position ${position.toString()}: ${e}";
    bubble()
  }

  public isDone(): Boolean {
    chars.end <= pos
  }

  // Only call this when !isDone().
  public peek(): Char {
    chars[pos] orelse panic()
  }

  public advance(): Void {
    pos = chars.next(pos);
  }

  public read(): Char {
    let ret = peek();
    advance();
    ret
  }

  public matchChar(s: Char): Boolean {
    if (!isDone() && peek() == s) {
      advance();
      true
    } else {
      false
    }
  }

  private matchRepeat(): Boolean {
    matchChar(char"+") || matchChar(char"*") || matchChar(char"?")
  }

  private isHexDigit(c: Char): Boolean {
    (c >= char"0" && c <= char"9")
      || (c >= char"a" && c <= char"f")
      || (c >= char"A" && c <= char"F")
  }

  private hexValue(c: Char): Int throws Bubble {
    if (c >= char"0" && c <= char"9") {
      c - char"0"
    } else if (c >= char"a" && c <= char"f") {
      c - char"a" + 10
    } else if (c >= char"A" && c <= char"F") {
      c - char"A" + 10
    } else {
      bubble()
    }
  }

  private readHexDigits(count: Int, escape: String): Int throws Bubble {
    var codePoint = 0;
    for (var i = 0; i < count; ++i) {
      if (isDone()) {
        error("incomplete ${escape} escape");
      }
      let c = read();
      codePoint = codePoint * 16 + (hexValue(c) orelse do {
        error("invalid hex digit in ${escape} escape");
        bubble()
      });
    }
    codePoint
  }

  private codePointsOf(codePoint: Int): CodePoints throws Bubble {
    new CodePoints(String.fromCodePoint(codePoint) orelse do {
      error("invalid code point ${codePoint.toString(16)}");
      bubble()
    })
  }

  // Parse a Unicode escape: \uXXXX (4 hex digits) or \u{X...} (1-6 hex digits)
  private finishUnicodeEscape(): RegexNode throws Bubble {
    if (matchChar(char"{")) {
      // Braced form: \u{X} to \u{XXXXXX}
      var codePoint = 0;
      var count = 0;
      while (!matchChar(char"}")) {
        if (isDone() || count >= 6) {
          error("invalid unicode escape");
        }
        let c = read();
        codePoint = codePoint * 16 + (hexValue(c) orelse do {
          error("invalid hex digit in unicode escape");
          bubble()
        });
        count = count + 1;
      }
      if (count == 0) {
        error("empty unicode escape");
      }
      codePointsOf(codePoint)
    } else {
      // Fixed form: \uXXXX (exactly 4 hex digits)
      var codePoint = readHexDigits(4, "unicode");
      // As in JavaScript, a code point above U+FFFF is written as two escapes,
      // a high surrogate then a low surrogate.
      if (codePoint >= 0xD800 && codePoint <= 0xDBFF) {
        if (!matchChar(char"\\") || !matchChar(char"u")) {
          error("high surrogate must be followed by a low surrogate");
        }
        let low = readHexDigits(4, "unicode");
        if (low < 0xDC00 || low > 0xDFFF) {
          error("high surrogate must be followed by a low surrogate");
        }
        codePoint = 0x10000 + (codePoint - 0xD800) * 0x400 + (low - 0xDC00);
      }
      codePointsOf(codePoint)
    }
  }

  // Consumes text if it comes next.
  private matchText(text: String): Boolean {
    var index = pos;
    for (let c of text) {
      if (!chars.hasIndex(index) || chars[index] != c) {
        return false;
      }
      index = chars.next(index);
    }
    pos = index;
    true
  }

  // Skips (?#...) comments, and inside (?x:...) also whitespace and comments
  // from # to the end of the line.
  private skipIgnored(): Void throws Bubble {
    while (!isDone()) {
      if (extended && isPatternSpace(peek())) {
        advance();
      } else if (extended && matchChar(char"#")) {
        while (!isDone() && !matchChar(char"\n")) {
          advance();
        }
      } else if (matchText("(?#")) {
        while (!matchChar(char")")) {
          if (isDone()) {
            error("missing closing paren in (?#...)");
          }
          advance();
        }
      } else {
        break;
      }
    }
  }

  // Whether the text after "(?" is letters and a colon, as in (?i:...).
  private atFlagGroup(): Boolean {
    var index = pos;
    while (chars.hasIndex(index) && isAsciiLetter(chars[index])) {
      index = chars.next(index);
    }
    index != pos && chars.hasIndex(index) && chars[index] == char":"
  }

  // Parse a flag group: (?i:...) matches ASCII letters in either case, and
  // (?x:...) ignores whitespace and # comments. Flags can combine, as in (?ix:...).
  private readFlagGroup(): RegexNode throws Bubble {
    let outerExtended = extended;
    let outerCaseless = caseless;
    while (!matchChar(char":")) {
      let flag = read();
      if (flag == char"i") {
        caseless = true;
      } else if (flag == char"x") {
        extended = true;
      } else {
        error("inline flag (?${String.fromCodePoint(flag)}:...) is not supported");
      }
    }
    let regex = readOr();
    // An enclosing (?i:...) already rewrites this group.
    let rewrite = caseless && !outerCaseless;
    extended = outerExtended;
    caseless = outerCaseless;
    if (!matchChar(char")")) {
      error("closing paren");
    }
    if (rewrite) {
      ignoreCase(regex)
    } else {
      regex
    }
  }

  // Whether the next two code points are \d, \D, \s, \S, \w, or \W.
  private atShorthand(): Boolean {
    if (isDone() || peek() != char"\\") {
      return false;
    }
    let after = chars.next(pos);
    if (!chars.hasIndex(after)) {
      return false;
    }
    when (chars[after]) {
      char"d", char"D", char"s", char"S", char"w", char"W" -> true;
      else -> false;
    }
  }

  public charClassBody(): RegexNode throws Bubble {
    let invert = matchChar(char"^");
    let opts = new ListBuilder<CodePart>();
    // \D, \S, and \W can't go in a CodeSet, so they're kept apart.
    let negations = new ListBuilder<RegexNode>();
    // Members of the shorthands, for building a negated class.
    let optMembers = new StringBuilder();
    let negatedMembers = new ListBuilder<String>();
    while (!matchChar(char"]")) {
      if (isDone()) {
        error("missing closing ']'");
      }
      if (atShorthand()) {
        advance();
        let letter = read();
        when (letter) {
          char"D", char"S", char"W" -> do {
            negations.add(new CodeSet([shorthandSet(letter)], true));
            negatedMembers.add(shorthandMembers(letter));
          }
          else -> do {
            opts.add(shorthandSet(letter));
            optMembers.append(shorthandMembers(letter));
          }
        }
        if (matchChar(char"-")) {
          if (matchChar(char"]")) {
            opts.add(new CodePoints("-"));
            break;
          }
          error("invalid range edge");
        }
        continue;
      }
      let first = charClassUnit();
      if (matchChar(char"-")) {
        if (matchChar(char"]")) {
          // Exit on square bracket either way. Would need escaped.
          opts.add(first);
          opts.add(new CodePoints("-"));
          break;
        }
        if (isDone()) {
          error("missing closing ']'");
        }
        let second = charClassUnit();
        let min = extractCode(first);
        let max = extractCode(second);
        if (min > max) {
          error("character class range is out of order");
        }
        opts.add(new CodeRange(min, max));
      } else {
        opts.add(first);
      }
    }
    let items = opts.toList();
    if (negations.isEmpty && !invert && items.length == 1 && !(items[0] is CodeRange)) {
      // A class of one character or shorthand, like [a] or [\d], is just that.
      // Ranges stay in a set because the Lua backend can't match a bare one.
      items[0]
    } else if (negations.isEmpty) {
      new CodeSet(items, invert)
    } else if (!invert) {
      // [a\D] matches a or a non-digit.
      if (!items.isEmpty) {
        negations.add(new CodeSet(items), 0);
      }
      if (negations.length == 1) {
        negations[0]
      } else {
        new Or(negations.toList())
      }
    } else {
      let excluded = if (caseless) { ignoreCaseParts(items) } else { items };
      negatedClass(excluded, optMembers.toString(), negatedMembers.toList())
    }
  }

  private charClassUnit(): CodePart throws Bubble {
    if (matchChar(char "\\")) {
      // \b inside a character class means backspace (U+0008), not word boundary
      if (matchChar(char"b")) {
        new CodePoints(String.fromCodePoint(8))
      } else {
        // charClassBody handles shorthands itself, so this only sees one that
        // ends a range, like [a-\D], or an anchor like \A. Neither is allowed.
        let escape = finishEscape();
        escape as CodePart orelse do {
          error("escape not allowed in a character class");
          bubble()
        }
      }
    } else {
      new CodePoints(String.fromCodePoint(read()))
    }
  }

  private extractCode(codePart: CodePart): Int throws Bubble {
    (codePart as CodePoints).value[String.begin] orelse do {
      error("invalid range edge");
      bubble()
    }
  }

  // Parse a hex escape: \xNN (exactly 2 hex digits)
  private finishHexEscape(): RegexNode throws Bubble {
    new CodePoints(String.fromCodePoint(readHexDigits(2, "hex")))
  }

  private finishEscape(): RegexNode throws Bubble {
    if (isDone()) {
      error("trailing '\\' at end of pattern");
    }
    var escapeCode = peek();
    if (matchChar(char"0")) {
      new CodePoints(String.fromCodePoint(0))
    } else if (matchChar(char"a")) {
      new CodePoints(String.fromCodePoint(7))   // bell
    } else if (matchChar(char"A")) {
      Begin
    } else if (matchChar(char"b")) {
      WordBoundary
    } else if (matchChar(char"B")) {
      error("\\B (non-word boundary) is not supported");
      bubble()
    } else if (matchChar(char"c")) {
      // Control character: \cA (or \ca) is U+0001, through \cZ, U+001A
      if (isDone() || !isAsciiLetter(peek())) {
        error("\\c must be followed by a letter");
      }
      new CodePoints(String.fromCodePoint(read() % 32))
    } else if (matchChar(char"d")) {
      Digit
    } else if (matchChar(char"D")) {
      new CodeSet([Digit], true)
    } else if (matchChar(char"e")) {
      new CodePoints(String.fromCodePoint(0x1B))  // escape
    } else if (matchChar(char"f")) {
      new CodePoints(String.fromCodePoint(12))  // form feed
    } else if (matchChar(char"n")) {
      new CodePoints("\n")
    } else if (matchChar(char"r")) {
      new CodePoints("\r")
    } else if (matchChar(char"s")) {
      Space
    } else if (matchChar(char"S")) {
      new CodeSet([Space], true)
    } else if (matchChar(char"t")) {
      new CodePoints("\t")
    } else if (matchChar(char"u")) {
      finishUnicodeEscape()
    } else if (matchChar(char"v")) {
      new CodePoints(String.fromCodePoint(11))  // vertical tab
    } else if (matchChar(char"w")) {
      Word
    } else if (matchChar(char"W")) {
      new CodeSet([Word], true)
    } else if (matchChar(char"x")) {
      finishHexEscape()
    } else if (matchChar(char"z")) {
      End
    } else if (isAsciiPunctuation(escapeCode) || escapeCode == char" ") {
      advance();
      new CodePoints(String.fromCodePoint(escapeCode))
    } else if (peek() >= char"1" && peek() <= char"9") {
      error("backreferences (\\${String.fromCodePoint(peek())}) are not supported");
      bubble()
    } else if (matchChar(char"p") || matchChar(char"P")) {
      error("Unicode property escapes (\\p{...}) are not supported");
      bubble()
    } else {
      error("unknown escape sequence: \\${String.fromCodePoint(peek())}");
      bubble()
    }
  }

  // Scratch space for brace quantifier parsing
  public var braceMin: Int = 0;
  // -1 means unbounded, -2 means "not a quantifier"
  public var braceMax: Int = 0;

  // Reads the next digit onto the end of count.
  private appendDigit(count: Int): Int throws Bubble {
    let digit = read() - char"0";
    if (count > (0x7FFFFFFF - digit) / 10) {
      error("repeat count is too large");
    }
    count * 10 + digit
  }

  // Try to parse a {n}, {n,}, or {n,m} quantifier.
  // Sets braceMin/braceMax and returns true on success.
  // Returns false and backtracks if not a valid quantifier.
  private tryParseBraceQuantifier(): Boolean throws Bubble {
    let savedPos = pos;
    if (!matchChar(char"{")) {
      return false;
    }
    // Parse min value directly as integer
    var min = 0;
    var minDigits = 0;
    while (!isDone() && peek() >= char"0" && peek() <= char"9") {
      min = appendDigit(min);
      minDigits = minDigits + 1;
    }
    if (minDigits == 0) {
      pos = savedPos;
      return false;
    }
    if (matchChar(char"}")) {
      // {n} — exact count
      braceMin = min;
      braceMax = min;
      return true;
    }
    if (!matchChar(char",")) {
      pos = savedPos;
      return false;
    }
    // Parse optional max value
    var max = 0;
    var maxDigits = 0;
    while (!isDone() && peek() >= char"0" && peek() <= char"9") {
      max = appendDigit(max);
      maxDigits = maxDigits + 1;
    }
    if (!matchChar(char"}")) {
      pos = savedPos;
      return false;
    }
    braceMin = min;
    if (maxDigits == 0) {
      // {n,} — unbounded
      braceMax = -1;
    } else {
      braceMax = max;
    }
    true
  }

  public readPostfix(exist: RegexNode): RegexNode throws Bubble {
    let repeat = if (matchChar(char"+")) {
      new Repeat(exist, 1, null, matchChar(char"?"))
    } else if (matchChar(char"*")) {
      new Repeat(exist, 0, null, matchChar(char"?"))
    } else if (matchChar(char"?")) {
      new Repeat(exist, 0, 1, matchChar(char"?"))
    } else if (tryParseBraceQuantifier()) {
      let nonGreedy = matchChar(char"?");
      if (braceMax != -1 && braceMin > braceMax) {
        error("quantifier {${braceMin.toString()},${braceMax.toString()}} has min greater than max");
      }
      if (braceMax == -1) {
        new Repeat(exist, braceMin, null, nonGreedy)
      } else {
        new Repeat(exist, braceMin, braceMax, nonGreedy)
      }
    } else {
      return exist;
    };
    if (matchRepeat() || tryParseBraceQuantifier()) {
      error("nothing to repeat");
    }
    repeat
  }

  private claimName(name: String): Void throws Bubble {
    if (!isCaptureName(name)) {
      error("invalid capture name '${name}'; use an ASCII letter followed by ASCII letters or digits");
    }
    if (names.has(name)) {
      error("duplicate capture name '${name}'");
    }
    names[name] = true;
  }

  // Slots can hold captures too, and every name in the pattern must be unique.
  private claimNames(node: RegexNode): Void throws Bubble {
    when (node) {
      is Capture -> do {
        claimName(node.name);
        claimNames(node.item);
      }
      is Or -> do {
        for (let item of node.items) {
          claimNames(item);
        }
      }
      is Sequence -> do {
        for (let item of node.items) {
          claimNames(item);
        }
      }
      is Repeat -> claimNames(node.item);
    }
  }

  public readSingle(): RegexNode throws Bubble {
    if (matchChar(char"[")) {
      charClassBody()
    } else if (matchChar(char"(")) {
      if (matchChar(char"?")) {
        // non capturing group
        if (matchChar(char":")) {
          let regex = readOr();
          if (!matchChar(char")")) {
            error("closing paren");
          }
          regex
        } else if (matchChar(char"$")) {
          let parts = new StringBuilder();
          while (!matchChar(char")")) {
            if (isDone()) {
              error("missing closing paren in (?$...)");
            }
            parts.appendCodePoint(read());
          }
          let str = parts.toString();
          let slot = slots[str] orelse do {
            error("no such slot: ${str}");
            bubble()
          };
          claimNames(slot);
          slot
        } else if (matchChar(char"=")) {
          error("positive lookhead is not supported");
          bubble()
        } else if (matchChar(char"<")) {
          if (matchChar(char"=")) {
            error("positive lookbehind (?<=...) is not supported");
            bubble()
          } else if (matchChar(char"!")) {
            error("negative lookbehind (?<!...) is not supported");
            bubble()
          } else {
            error("(?<name>...) named capture syntax is not supported; use (?name=pattern) instead");
            bubble()
          }
        } else if (matchChar(char"!")) {
          error("negative lookahead is not supported");
          bubble()
        } else if (atFlagGroup()) {
          readFlagGroup()
        } else {
          // Detect common unsupported syntax before named capture parsing
          if (!isDone()) {
            let checkPos = pos;
            let fc = read();
            if (!isDone()) {
              if (fc == char"P" && (peek() == char"<" || peek() == char"=" || peek() == char">")) {
                // (?P<name>...), (?P=name), (?P>name) — Python-style groups
                error("Python-style (?P...) groups are not supported; use (?name=pattern) instead");
              }
            }
            pos = checkPos;
          }
          // Named capture: (?name=pattern)
          let str = new StringBuilder();
          while (matchChar(char" ")) {}
          while (!isDone() && peek() != char" " && peek() != char"=") {
            str.appendCodePoint(read());
          }
          while (matchChar(char" ")) {}
          if (!matchChar(char"=")) {
            error("missing = in (?${str.toString()}=...)");
          }
          let name = str.toString();
          claimName(name);
          let regex = readOr();
          if (!matchChar(char")")) {
            error("closing paren");
          }
          new Capture(name, regex)
        }
      } else {
        let regex = readOr();
        if (!matchChar(char")")) {
          error("closing paren");
        }
        regex
      }
    } else if (matchChar(char"^")) {
      Begin
    } else if (matchChar(char"$")) {
      End
    } else if (matchChar(char".")) {
      Dot
    } else if (matchChar(char "\\")) {
      finishEscape()
    } else if (matchRepeat()) {
      error("invalid repeat");
      bubble()
    } else {
      new CodePoints(String.fromCodePoint(read()))
    }
  }

  public readSeq(): RegexNode throws Bubble {
    let seq = new ListBuilder<RegexNode>();
    // Maintain a buffer for sequential code points.
    let codeBuffer = new ListBuilder<String>();
    let popCodeBuffer(): Void throws Bubble {
      if (!codeBuffer.isEmpty) {
        // TODO If we add `clear` to StringBuilder, we can use that here.
        seq.add(new CodePoints(codeBuffer.join("") { it => it }));
        codeBuffer.clear();
      }
    }
    let add(regex: RegexNode): Void throws Bubble {
      when (regex) {
        is CodePoints -> codeBuffer.add(regex.value);
        else -> do {
          popCodeBuffer();
          seq.add(regex);
        }
      }
    }
    // Loop through everything at this level.
    skipIgnored();
    while (!isDone() && peek() != char"|" && peek() != char")") {
      let single = readSingle();
      skipIgnored();
      let regex = readPostfix(single);
      when (regex) {
        // A group like (?:b.) in a(?:b.)c needs no nesting.
        is Sequence -> do {
          for (let item of regex.items) {
            add(item);
          }
        }
        else -> add(regex);
      }
      skipIgnored();
    }
    popCodeBuffer();
    // Finish result.
    when (seq.length) {
      1 -> seq[0];
      else -> new Sequence(seq.toList());
    }
  }

  public readOr(): RegexNode throws Bubble {
    let ors = new ListBuilder<RegexNode>();
    while (!isDone() && peek() != char")") {
      if (ors.length != 0 && !matchChar(char"|")) {
        error("or");
      }
      let regex = readSeq();
      when (regex) {
        // A group like (?:a|b) in (?:a|b)|c needs no nesting.
        is Or -> ors.addAll(regex.items);
        else -> ors.add(regex);
      }
    }
    when (ors.length) {
      1 -> ors[0];
      else -> new Or(ors.toList());
    }
  }

  public readAll(): RegexNode throws Bubble {
    let result = readOr();
    if (!isDone()) {
      error("unexpected ')'; unmatched closing parenthesis");
    }
    result
  }
}
