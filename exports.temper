let { ... } = import("std/regex");

export let compileWith(
  src: String,
  slots: Mapped<String, RegexNode>,
): Regex throws Bubble {
  parseWith(src, slots).compiled()
}

export let compile(src: String): Regex throws Bubble {
  parse(src).compiled()
}

export let parseWith(
  src: String,
  slots: Mapped<String, RegexNode>,
): RegexNode throws Bubble {
  new Parser(src, slots).readAll()
}

export let parse(src: String): RegexNode throws Bubble {
  new Parser(src).readAll()
}

/**
 * Writes a node as pattern text that parses back to an equivalent node.
 * Bubbles for node types this library doesn't know or code points that
 * aren't valid.
 */
export let format(node: RegexNode): String throws Bubble {
  let out = new StringBuilder();
  formatTo(out, node);
  out.toString()
}

/** Escapes text so it matches literally, outside of a (?x:...) group. */
export let escape(text: String): String {
  let out = new StringBuilder();
  for (let c of text) {
    appendCode(out, c, false) orelse panic();
  }
  out.toString()
}

export let parseError(
  src: String,
  slots: Mapped<String, RegexNode> = noSlots,
): String? {
  let parser = new Parser(src, slots);
  let parsed = do {
    parser.readAll();
    true
  } orelse false;
  if (parsed) {
    null
  } else {
    parser.errorMessage
  }
}
